# Signs newsletter confirmation links. Required: generate with `openssl rand -hex 32`.
NEWSLETTER_SECRET=
# The page that confirms a subscription. Required.
CONFIRM_URL_BASE=https://demo.example/newsletter/confirm
# Optional: how long a confirmation link lasts, and sign-ups allowed per IP per hour.
CONFIRM_TTL_HOURS=48
SIGNUPS_PER_HOUR=5
